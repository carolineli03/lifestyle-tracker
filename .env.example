# ---------------------------------------------------------------------------
# Lifestyle Tracker environment variables
# Copy to .env.local and fill in.  .env.local is gitignored; never commit it.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project URL and anon key.  Both are safe in the browser bundle: the anon key
# is only useful in combination with a signed-in session, and every table is
# protected by Row Level Security.
# Find these at: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Site -----------------------------------------------------------------
# Used to build the magic-link redirect URL. In local dev this is
# http://localhost:3000. On Vercel set it to your deployed origin
# (e.g. https://lifestyle-tracker.vercel.app) — no trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Anthropic ------------------------------------------------------------
# SERVER ONLY. No NEXT_PUBLIC_ prefix, so Next.js will never inline it into the
# client bundle. Only route handlers under src/app/api/* read this.
ANTHROPIC_API_KEY="sk-ant-..."

# --- RLS policy tests (optional, local only) -------------------------------
# `npm test` runs the RLS suite against a throwaway database it creates and
# drops itself. Point this at any Postgres whose role can CREATE DATABASE —
# a `supabase start` stack, a container, or a bare local cluster.
# If it is unreachable the RLS tests skip with a loud warning instead of
# failing. See README > Running the tests.
TEST_DATABASE_URL="postgres://postgres@127.0.0.1:54322/postgres"
